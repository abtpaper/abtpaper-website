# Read-only Sanity token. Only needed if the Sanity dataset is private.
# Get one at https://www.sanity.io/manage/personal/project/wox2571x/api
#   → Tokens → Add API token → name: "site-read", permissions: Viewer
# For local dev, put in .env.local (gitignored).
# For production, store as GitHub Actions secret SANITY_READ_TOKEN.
SANITY_READ_TOKEN=

# Web3Forms access key. Public identifier (safe in HTML).
# Get one for free at https://web3forms.com/
#   1. Enter overseas@abtpaper.com as the destination
#   2. Copy the access key
# Store as GitHub Actions secret WEB3FORMS_ACCESS_KEY.
WEB3FORMS_ACCESS_KEY=
