---
interface Props {
  activeNav?: "products" | "applications" | "company" | "contact" | null;
}
const { activeNav = null } = Astro.props;
---

<header class="site-header">
  <div class="container">
    <a href="/" class="brand" aria-label="ABT Digital Paper">
      <img class="brand-logo" src="/abt_logo.png" alt="ABT Digital Paper" />
    </a>
    <nav class="primary" aria-label="Primary">
      <a href="/#series-01" class={activeNav === "products" ? "active" : ""}>Products</a>
      <a href="/#manuf" class={activeNav === "applications" ? "active" : ""}>Manufacturing</a>
      <a href="/about" class={activeNav === "company" ? "active" : ""}>Company</a>
      <a href="/news">News</a>
    </nav>
    <div class="header-tools">
      <button class="theme-toggle" onclick="toggleTheme()" aria-label="Toggle theme">
        <span data-theme-label>DARK</span>
      </button>
      <a href="/#contact" class="btn-cta">Request sample <span class="arr">→</span></a>
    </div>
  </div>
</header>
