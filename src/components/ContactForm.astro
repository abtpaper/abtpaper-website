---
// "Talk to us" web form. Submits via Web3Forms → emails overseas@abtpaper.com.
// Access key is a public identifier (safe to expose in HTML) that Web3Forms
// uses to route submissions to the pre-registered inbox. Set in an env var
// so we can rotate it without a code change.
import { COUNTRIES } from "../lib/countries";
const accessKey = import.meta.env.WEB3FORMS_ACCESS_KEY ?? "";
---

<form class="talk-form" id="talk-form" novalidate>
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="subject" value="ABT website — inquiry" />
  <input type="hidden" name="from_name" value="ABT Digital Paper — website" />
  <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" />

  <div class="tf-row">
    <label>
      <span class="tf-label">First name<em>*</em></span>
      <input type="text" name="first_name" required autocomplete="given-name" />
    </label>
    <label>
      <span class="tf-label">Last name<em>*</em></span>
      <input type="text" name="last_name" required autocomplete="family-name" />
    </label>
  </div>

  <div class="tf-row">
    <label>
      <span class="tf-label">Country<em>*</em></span>
      <select name="country" required autocomplete="country-name">
        <option value="">— Select country —</option>
        {COUNTRIES.map((c) => <option value={c}>{c}</option>)}
      </select>
    </label>
    <label>
      <span class="tf-label">City</span>
      <input type="text" name="city" autocomplete="address-level2" />
    </label>
  </div>

  <div class="tf-row">
    <label>
      <span class="tf-label">Phone</span>
      <input type="tel" name="phone" autocomplete="tel" />
    </label>
    <label>
      <span class="tf-label">Company</span>
      <input type="text" name="company" autocomplete="organization" />
    </label>
  </div>

  <label class="tf-full">
    <span class="tf-label">E-mail<em>*</em></span>
    <input type="email" name="email" required autocomplete="email" />
  </label>

  <label class="tf-full">
    <span class="tf-label">Product interest</span>
    <select name="product" id="tf-product">
      <option value="">— Select a series (optional) —</option>
      <option value="Base Paper">Base Paper — offset / kraft</option>
      <option value="PE-Laminated Base Paper">PE-Laminated Base Paper</option>
      <option value="Food-Grade Paper">Food-Grade Paper</option>
      <option value="RC Photo Paper">RC-coated Photo Paper</option>
      <option value="Other / not sure">Other / not sure</option>
    </select>
  </label>

  <label class="tf-full">
    <span class="tf-label">Your message</span>
    <textarea name="message" rows="5" placeholder="Weight / finish / format needed, estimated quantity, use case, timeline, anything else."></textarea>
  </label>

  <div class="tf-actions">
    <button type="submit" class="btn-cta tf-submit">
      Send inquiry <span class="arr">→</span>
    </button>
    <span class="tf-status" role="status" aria-live="polite"></span>
  </div>

  <p class="tf-privacy">
    <span class="tf-req"><em>*</em>&nbsp;Required&nbsp;fields.</span>&nbsp;&nbsp;
    Your inquiry is sent directly to our sales team at <b>overseas@abtpaper.com</b>.
    We reply within 1&ndash;2 business days.
  </p>
</form>

<style>
  .talk-form {
    display: flex; flex-direction: column;
    gap: 20px;
    max-width: 700px;
  }
  .tf-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .tf-full { display: block; }
  .talk-form label {
    display: flex; flex-direction: column;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--muted);
    text-transform: uppercase;
  }
  .tf-label em {
    color: var(--red);
    font-style: normal;
    margin-left: 3px;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 700;
  }
  .talk-form input[type="text"],
  .talk-form input[type="tel"],
  .talk-form input[type="email"],
  .talk-form select,
  .talk-form textarea {
    font-family: var(--font-sans);
    font-size: 15px;
    letter-spacing: 0;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--hairline);
    padding: 12px 14px;
    text-transform: none;
    width: 100%;
    box-sizing: border-box;
    border-radius: 0;
  }
  .talk-form input:focus,
  .talk-form select:focus,
  .talk-form textarea:focus {
    outline: 2px solid var(--gold);
    outline-offset: -1px;
    border-color: var(--gold);
  }
  .talk-form input:invalid:not(:placeholder-shown),
  .talk-form textarea:invalid:not(:placeholder-shown) {
    border-color: color-mix(in oklab, var(--red) 60%, var(--hairline));
  }
  .talk-form textarea { resize: vertical; min-height: 120px; }

  .tf-actions { display: flex; align-items: center; gap: 20px; margin-top: 4px; }
  .tf-submit { cursor: pointer; border: none; font-family: inherit; }
  .tf-submit[disabled] { opacity: 0.6; cursor: wait; }
  .tf-status {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .tf-status.ok { color: var(--green); }
  .tf-status.err { color: var(--red); }
  .tf-privacy {
    font-family: var(--font-sans);
    font-size: 12.5px;
    color: var(--muted);
    margin: 8px 0 0;
    line-height: 1.6;
  }
  .tf-privacy .tf-req {
    color: var(--ink-2);
    font-weight: 500;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .tf-privacy .tf-req em {
    color: var(--red);
    font-style: normal;
    font-weight: 700;
  }
  .tf-privacy b {
    color: var(--ink);
    font-weight: 600;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .tf-row { grid-template-columns: 1fr; }
  }
</style>

<script is:inline>
  (function () {
    const form = document.getElementById("talk-form");
    if (!form) return;
    const status = form.querySelector(".tf-status");
    const btn = form.querySelector(".tf-submit");
    const select = form.querySelector("#tf-product");

    // ---- Series pre-selection ----------------------------------------
    // Any link with data-series-name (Request a sample / Talk to us on
    // each series section) sets the product dropdown to that series,
    // then lets the normal anchor scroll to #contact fire.
    function preselect(seriesName) {
      if (!select || !seriesName) return;
      for (const opt of select.options) {
        if (opt.value === seriesName) {
          select.value = opt.value;
          // Brief gold flash so the user sees it changed.
          select.style.transition = "background-color 0.6s";
          select.style.backgroundColor = "var(--gold-soft)";
          setTimeout(() => { select.style.backgroundColor = ""; }, 1400);
          return;
        }
      }
    }

    document.addEventListener("click", (ev) => {
      const link = ev.target.closest("[data-series-name]");
      if (!link) return;
      preselect(link.getAttribute("data-series-name"));
    });

    // Also handle ?series=... in the URL (shareable deep links).
    const params = new URLSearchParams(location.search);
    if (params.get("series")) preselect(params.get("series"));
    // ------------------------------------------------------------------

    form.addEventListener("submit", async (ev) => {
      ev.preventDefault();
      status.textContent = "";
      status.className = "tf-status";

      // HTML5 validity check with visible message
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      btn.disabled = true;
      const oldLabel = btn.innerHTML;
      btn.innerHTML = "Sending…";

      const data = new FormData(form);
      // Anti-bot: if honeypot filled, silently drop.
      if (data.get("botcheck")) {
        btn.disabled = false;
        btn.innerHTML = oldLabel;
        return;
      }

      // Fallback path — if the Web3Forms access key isn't configured yet,
      // build a mailto: URL with all the form data as the email body and
      // hand it to the visitor's mail client. Works today; upgrades to
      // direct submission the moment the access_key env var is set.
      const accessKey = data.get("access_key");
      if (!accessKey) {
        const fields = [
          ["Name",    [data.get("first_name"), data.get("last_name")].filter(Boolean).join(" ")],
          ["Company", data.get("company")],
          ["Email",   data.get("email")],
          ["Phone",   data.get("phone")],
          ["Country", data.get("country")],
          ["City",    data.get("city")],
          ["Product interest", data.get("product")],
          ["Message", data.get("message")],
        ];
        const body = fields
          .filter(([, v]) => v && String(v).trim())
          .map(([k, v]) => `${k}: ${v}`)
          .join("\n\n");
        const href =
          "mailto:overseas@abtpaper.com" +
          "?subject=" + encodeURIComponent("ABT website — inquiry") +
          "&body=" + encodeURIComponent(body);
        window.location.href = href;
        status.textContent = "Opening your email app… if nothing happens, email overseas@abtpaper.com directly.";
        status.className = "tf-status ok";
        btn.disabled = false;
        btn.innerHTML = oldLabel;
        return;
      }

      try {
        const res = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          body: data,
        });
        const json = await res.json();
        if (json.success) {
          form.reset();
          status.textContent = "Sent — we'll be in touch.";
          status.className = "tf-status ok";
        } else {
          status.textContent = json.message || "Send failed. Please email overseas@abtpaper.com directly.";
          status.className = "tf-status err";
        }
      } catch (err) {
        status.textContent = "Network error. Please email overseas@abtpaper.com directly.";
        status.className = "tf-status err";
      } finally {
        btn.disabled = false;
        btn.innerHTML = oldLabel;
      }
    });
  })();
</script>
