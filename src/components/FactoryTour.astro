---
interface Tile {
  image: string;
  title: string;
  sub: string;
}
interface Props {
  eyebrow: string;
  title: string;
  lede: string;
  tiles: Tile[];
}
const { eyebrow, title, lede, tiles } = Astro.props;
---

<section class="block factory-tour">
  <div class="container">
    <div class="section-head">
      <span class="section-eyebrow">{eyebrow}</span>
      <div>
        <h2 class="section-title">{title}</h2>
        <p class="section-lede">{lede}</p>
      </div>
    </div>
    <div class="tour-grid">
      {
        tiles.map((t) => (
          <figure class="tour-tile">
            <img src={t.image} alt={t.title} loading="lazy" />
            <figcaption>
              <h4>{t.title}</h4>
              <p>{t.sub}</p>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .tour-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
  }
  .tour-tile {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--deep);
  }
  .tour-tile img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform .4s ease;
  }
  .tour-tile:hover img { transform: scale(1.03); }
  .tour-tile figcaption {
    position: absolute; bottom: 0; left: 0; right: 0;
    padding: 16px 20px;
    background: linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.78) 100%);
    color: #fff;
  }
  .tour-tile figcaption h4 {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 15.5px;
    letter-spacing: -0.005em;
    margin: 0 0 3px;
  }
  .tour-tile figcaption p {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.8);
    text-transform: uppercase;
    margin: 0;
  }
  @media (max-width: 900px) {
    .tour-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .tour-grid { grid-template-columns: 1fr; }
  }
</style>
