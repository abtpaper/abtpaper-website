---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import SiteHeader from '../../components/SiteHeader.astro'
import SiteFooter from '../../components/SiteFooter.astro'

export async function getStaticPaths() {
  const posts = await getCollection('news', ({ data }) => !data.draft)
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content } = await render(post)

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
---

<BaseLayout title={`${post.data.title} — ABT News`} description={post.data.excerpt}>
  <SiteHeader />

  <article class="post">
    {post.data.heroImage && (
      <div class="post-hero">
        <img src={post.data.heroImage} alt="" />
      </div>
    )}

    <div class="container post-head">
      <div class="post-meta">
        <a href="/news" class="back">← All news</a>
        <span class="sep">·</span>
        <span class="date">{fmt(post.data.date)}</span>
        <span class="sep">·</span>
        <span class="cat">{post.data.category}</span>
      </div>
      <h1 class="post-title">{post.data.title}</h1>
      <p class="post-lede">{post.data.excerpt}</p>
    </div>

    <div class="container post-body">
      <Content />
    </div>
  </article>

  <SiteFooter />
</BaseLayout>

<style>
  .post { padding-block: 0 0; }
  .post-hero {
    aspect-ratio: 21/9;
    background: var(--deep);
    overflow: hidden;
    border-bottom: 1px solid var(--hairline);
  }
  .post-hero img {
    width: 100%; height: 100%;
    object-fit: cover;
  }
  .post-head {
    padding-block: clamp(50px, 6vw, 80px) clamp(30px, 4vw, 50px);
  }
  .post-meta {
    display: flex; flex-wrap: wrap;
    gap: 10px; align-items: baseline;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--muted);
    text-transform: uppercase;
    margin-bottom: 24px;
  }
  .post-meta .sep { color: var(--hairline); }
  .post-meta .back { color: var(--gold-deep); text-decoration: none; }
  .post-meta .back:hover { color: var(--gold); }
  .post-meta .cat { color: var(--gold-deep); font-weight: 600; }
  .post-title {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: clamp(36px, 5vw, 60px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin: 0 0 24px;
    color: var(--ink);
    max-width: 22ch;
    text-wrap: balance;
  }
  .post-lede {
    font-size: 19px;
    color: var(--ink-2);
    max-width: 55ch;
    margin: 0;
    line-height: 1.55;
    font-weight: 300;
  }
  .post-body {
    padding-block: clamp(30px, 4vw, 60px) clamp(60px, 8vw, 100px);
    border-top: 1px solid var(--hairline);
    margin-top: 40px;
    max-width: 68ch;
    font-size: 16.5px;
    color: var(--ink);
    line-height: 1.7;
  }
  .post-body :global(h2) {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 26px;
    letter-spacing: -0.015em;
    margin: 40px 0 16px;
    color: var(--ink);
  }
  .post-body :global(h3) {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 20px;
    letter-spacing: -0.01em;
    margin: 30px 0 12px;
    color: var(--ink);
  }
  .post-body :global(p) { margin: 0 0 20px; }
  .post-body :global(ul), .post-body :global(ol) { margin: 0 0 24px; padding-left: 24px; }
  .post-body :global(li) { margin: 8px 0; }
  .post-body :global(a) { color: var(--gold-deep); text-decoration: underline; text-underline-offset: 3px; }
  .post-body :global(a:hover) { color: var(--gold); }
  .post-body :global(strong) { color: var(--ink); font-weight: 600; }
  .post-body :global(blockquote) {
    border-left: 3px solid var(--gold);
    padding-left: 20px;
    margin: 24px 0;
    font-style: italic;
    color: var(--ink-2);
  }
  .post-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--paper-2);
    padding: 2px 6px;
  }
</style>
